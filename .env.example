# El catálogo abierto, OCR y fuente propia no necesitan claves. La búsqueda externa es opcional.
PORT=3001
HOST=127.0.0.1
PYTHON_BIN=python3
# Un proceso de análisis por instancia, sin cola. Ajustar tras medir en tu VPS.
ENGINE_TIMEOUT_MS=45000
# Solo si se ejecuta detrás de UN proxy Nginx de confianza:
TRUST_PROXY=0
# Los datos oficiales de ambos idiomas se incluyen en engine/tessdata.
TESSERACT_LANG=spa+eng

# Opcional: reconocimiento externo real. Desactivado sin clave y acceso confirmado.
# Obtén la clave en https://www.whatfontis.com/API-identify-fonts-from-image.html
# Nunca uses VITE_ para una clave. No hace falta para el catálogo abierto o la fuente propia.
WFI_API_KEY=
# personal-free SOLO para uso personal autorizado; para otro uso, confirma condiciones con el proveedor.
# commercial-authorized-free SOLO tras acordar acceso gratuito comercial con el proveedor.
WFI_ACCESS=
WFI_DAILY_LIMIT=20
# Contador persistente para Node, fuera de la carpeta pública. Conserva el archivo entre reinicios.
WFI_QUOTA_FILE=.fontea/external-quota.json
