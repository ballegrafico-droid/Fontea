# No se necesitan claves ni servicios de pago.
PORT=3001
HOST=127.0.0.1
PYTHON_BIN=python3
# Un proceso de análisis por instancia, sin cola. Ajustar tras medir en tu VPS.
ENGINE_TIMEOUT_MS=45000
# Solo si se ejecuta detrás de UN proxy Nginx de confianza:
TRUST_PROXY=0
# Los datos oficiales de ambos idiomas se incluyen en engine/tessdata.
TESSERACT_LANG=spa+eng
